{
  "name": "gw2-squaded-worker",
  "private": true,
  "version": "0.1.0",
  "description": "Thin backend for GW2-Squaded: generates/resolves shareable immutable links for builds and squad comps.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "register-commands": "tsx --env-file=.dev.vars scripts/register-commands.ts",
    "register-emojis": "tsx --env-file=.dev.vars scripts/register-emojis.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.3.0"
  }
}
