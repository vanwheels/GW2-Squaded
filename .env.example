# Optional override for the worker/ share backend's base URL — the real deployed URL is already
# baked in as a default (see src/renderer/share/share-client.ts), so this is only needed to point
# a dev build at something else, e.g. a local `wrangler dev` instance (http://127.0.0.1:8787).
VITE_SHARE_API_BASE_URL=
