.env
.env.local

# Wrangler local secrets (Discord bot token/public key, etc.) — production secrets go through
# `wrangler secret put` instead, never a committed file.
.dev.vars

# Raw /v2/items dump cache for scripts/fetch-gear-upgrades.ts (~74k items, slow to refetch) —
# not the normalized output (that's data/game-data/*.json, which IS committed).
.cache/

# Build output of `npm run build:web-preview` (vite.web-preview.config.ts) — the Discord bot's
# /builddisplay render page + its staged game-data JSON copy (scripts/sync-web-preview-game-data.ts).
# Entirely a build artifact regenerated from src/web-preview/ + data/game-data/, never committed.
worker/public/

.vscode/*
!.vscode/extensions.json
